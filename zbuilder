FROM --platform=$BUILDPLATFORM node:24-bookworm AS builder

WORKDIR /app

ENV CI=true

RUN npm install -g mint

COPY . .

WORKDIR /app/docs

RUN mint export --output /tmp/bun-docs.zip && unzip -q /tmp/bun-docs.zip -d /app/dist

FROM ikxin/caddy:latest

COPY --from=builder /app/dist /usr/share/caddy

EXPOSE 8080
